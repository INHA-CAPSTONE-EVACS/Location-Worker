FROM ghcr.io/eclipse-sumo/sumo:v1_26_0

USER root
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip

COPY adapter/requirements.txt /app/adapter/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /app/adapter/requirements.txt

COPY adapter/ /app/adapter/
COPY dashboard/generate_map.py /app/dashboard/generate_map.py
COPY scenario/ /app/scenario/
ENV PYTHONPATH=/usr/share/sumo/tools

ENTRYPOINT ["python3", "/app/adapter/publish.py"]
