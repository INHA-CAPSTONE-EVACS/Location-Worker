<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="mini.net.xml"/>
    <route-files value="mini.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="60"/>
    <step-length value="0.1"/>
  </time>
  <processing>
    <time-to-teleport value="-1"/>
  </processing>
  <report>
    <no-step-log value="true"/>
    <duration-log.disable value="true"/>
  </report>
</configuration>
