FROM ghcr.io/eclipse-sumo/sumo:v1_26_0

USER root
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends x11vnc novnc websockify

COPY scenario/ /app/scenario/
COPY gui/start.sh /app/gui/start.sh
RUN chmod +x /app/gui/start.sh

ENV DISPLAY=:1
ENTRYPOINT ["/app/gui/start.sh"]
