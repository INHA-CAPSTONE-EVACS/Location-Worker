# EC2 private ENI address only. Never use 0.0.0.0 for Redis.
REDIS_BIND_ADDRESS=43.201.17.52
CENTRAL_REDIS_PASSWORD=replace-with-a-long-random-secret

# Local source checkout on the central EC2. It is built by Docker Compose.
WEBSOCKET_BUILD_CONTEXT=/opt/evacs/ws-gateway
WEBSOCKET_DOCKERFILE=Dockerfile
WEBSOCKET_LOCAL_IMAGE=evacs-ws-gateway:local

# Place this address behind an ALB/NLB or set it to the central EC2 private IP.
WS_BIND_ADDRESS=43.201.17.52
WS_PORT=8080
WS_CONTAINER_PORT=8080
