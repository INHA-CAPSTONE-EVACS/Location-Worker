# The worker image is built directly from this repository on each worker EC2.
LOCATION_WORKER_LOCAL_IMAGE=evacs-location-worker:local

# URL-encode reserved characters in CENTRAL_REDIS_PASSWORD.
CENTRAL_REDIS_URL=redis://:replace-with-a-long-random-secret@10.0.10.25:6379/0

# These must differ on every worker EC2 instance.
WORKER_CONSUMER_NAME=location-worker-worker-a
WORKER_INSTANCE_ID=worker-a

H3_RESOLUTION=9
DENSITY_INTERVAL_MS=1000
CLEANUP_INTERVAL_MS=1000
INACTIVE_TTL_MS=5000
